{
  "name": "telegram-web-clone",
  "version": "1.0.0",
  "description": "Simplified Telegram Web Clone built with Clean Architecture, Node.js, Express, WebSockets, MongoDB, and Vanilla JS.",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "nodemon backend/server.js",
    "test": "jest --runInBand --detectOpenHandles",
    "test:unit": "jest tests/unit",
    "test:integration": "jest --runInBand tests/integration",
    "test:ws": "jest --runInBand tests/ws"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 60000
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.7.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.7",
    "supertest": "^7.3.2"
  }
}
